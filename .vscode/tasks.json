{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build snake",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-pthread",
                "main.cpp",
                "-o",
                "snake"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}